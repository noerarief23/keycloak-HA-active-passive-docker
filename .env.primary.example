# Environment variables for Primary Server (Server A - Active)

# ============================================
# Port Configuration
# ============================================
# PostgreSQL Primary Port (exposed to host)
POSTGRES_PRIMARY_PORT=5432

# Keycloak Primary HTTP Port (exposed to host)
KEYCLOAK_PRIMARY_HTTP_PORT=8080

# Keycloak Primary Management Port (for health checks)
KEYCLOAK_PRIMARY_MGMT_PORT=9000

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_PASSWORD=your_secure_postgres_password
REPLICATION_PASSWORD=your_secure_replication_password
KEYCLOAK_DB_PASSWORD=your_secure_keycloak_db_password

# ============================================
# Keycloak Configuration
# ============================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password
KC_HOSTNAME=server-a.example.com

# Note: Replace these with actual secure passwords in production
# Generate strong passwords using: openssl rand -base64 32

# ============================================
# HAProxy Load Balancer Configuration
# ============================================
# If using HAProxy load balancer, configure these settings

# HAProxy Server IP (where HAProxy is running)
# Keycloak will connect to database via this HAProxy for automatic failover
# For single-host deployment, use the host IP
HAPROXY_SERVER_IP=172.40.7.51

# HAProxy PostgreSQL Port (load balanced database connection)
HAPROXY_POSTGRES_PORT=15434

# HAProxy stats page credentials
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=changeme_secure_password

# ============================================
# Backend Server IPs (for HAProxy backend configuration)
# ============================================
# These are used by HAProxy to know where to route traffic
# For single-host deployment, both can be the same IP

# Primary backend server IP (for HAProxy to connect to primary services)
PRIMARY_BACKEND_IP=192.168.1.10

# Replica backend server IP (for HAProxy to connect to replica services)
REPLICA_BACKEND_IP=192.168.1.11

# Note: For local testing with Docker networks, use container IPs:
# PRIMARY_BACKEND_IP=172.41.1.10
# REPLICA_BACKEND_IP=172.41.2.20

# Note: If you want Keycloak to connect directly to PostgreSQL (no automatic failover),
# comment out HAPROXY_SERVER_IP and HAPROXY_POSTGRES_PORT above, then edit
# docker-compose-primary.yml to use the direct connection line instead
