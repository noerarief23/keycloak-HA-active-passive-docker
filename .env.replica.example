# Environment variables for Replica Server (Server B - Passive)

# ============================================
# Port Configuration
# ============================================
# PostgreSQL Replica Port (exposed to host)
POSTGRES_REPLICA_PORT=5433

# Keycloak Replica HTTP Port (exposed to host)
KEYCLOAK_REPLICA_HTTP_PORT=8081

# Keycloak Replica Management Port (for health checks)
KEYCLOAK_REPLICA_MGMT_PORT=9001

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_PASSWORD=your_secure_postgres_password
REPLICATION_PASSWORD=your_secure_replication_password
KEYCLOAK_DB_PASSWORD=your_secure_keycloak_db_password

# ============================================
# Keycloak Configuration
# ============================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password

# Keycloak Hostname Configuration (for HAProxy/Reverse Proxy)
# Set this to your domain name when using HAProxy or reverse proxy
# Must match primary server configuration
KC_HOSTNAME=example.com

# Keycloak Port (the port clients use to access Keycloak)
# Set this to HAProxy HTTPS port if using HAProxy
KC_HOSTNAME_PORT=10443

# Hostname strict mode (set to false for development)
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false

# Proxy mode (edge = behind reverse proxy like HAProxy)
KC_PROXY=edge

# Proxy headers (xforwarded = trust X-Forwarded-* headers from proxy)
KC_PROXY_HEADERS=xforwarded

# ============================================
# Primary Server Configuration (for PostgreSQL replication)
# ============================================
# Primary server IP address (where primary PostgreSQL is running)
# This is used by postgres-replica to connect and replicate from primary
PRIMARY_SERVER_IP=<server-a-ip>

# Primary PostgreSQL Port (for replication connection)
# Must match POSTGRES_PRIMARY_PORT on primary server
PRIMARY_POSTGRES_PORT=5432

# Note: Replace these with actual secure passwords in production
# The passwords must match the primary server configuration

# ============================================
# HAProxy Load Balancer Configuration
# ============================================
# If using HAProxy load balancer, configure these settings

# HAProxy Server IP (where HAProxy is running)
# Keycloak will connect to database via this HAProxy for automatic failover
# For single-host deployment, use the host IP
HAPROXY_SERVER_IP=<haproxy-ip>

# HAProxy PostgreSQL Port (load balanced database connection)
HAPROXY_POSTGRES_PORT=15434

# HAProxy stats page credentials (must match primary server)
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=changeme_secure_password

# ============================================
# Backend Server IPs (for HAProxy backend configuration)
# ============================================
# These are used by HAProxy to know where to route traffic
# For single-host deployment, both can be the same IP

# Primary backend server IP (for HAProxy to connect to primary services)
PRIMARY_BACKEND_IP=<server-a-ip>

# Replica backend server IP (for HAProxy to connect to replica services)
REPLICA_BACKEND_IP=<server-b-ip>

# Note: For local testing with Docker networks, use container IPs:
# PRIMARY_BACKEND_IP=172.41.1.10
# REPLICA_BACKEND_IP=172.41.2.20

# Note: If you want Keycloak to connect directly to PostgreSQL (no automatic failover),
# comment out HAPROXY_SERVER_IP and HAPROXY_POSTGRES_PORT above, then edit
# docker-compose-replica.yml to use the direct connection line instead
