# HAProxy Load Balancer Configuration
# Copy this file to .env and update with your actual values

# ============================================
# HAProxy Port Configuration
# ============================================
# HTTP Port (redirects to HTTPS)
HAPROXY_HTTP_PORT=80

# HTTPS Port (Keycloak frontend)
# This is the port that clients use to access Keycloak
# IMPORTANT: This port will be sent to Keycloak via X-Forwarded-Port header
HAPROXY_HTTPS_PORT=443

# PostgreSQL Port (load balanced)
HAPROXY_POSTGRES_PORT=5432

# Statistics/Monitoring Port
HAPROXY_STATS_PORT=8404

# ============================================
# HAProxy Statistics Page Authentication
# ============================================
# Username for accessing HAProxy stats page at http://<haproxy-ip>:8404/stats
HAPROXY_STATS_USER=admin

# Password for stats page (CHANGE THIS IN PRODUCTION!)
HAPROXY_STATS_PASSWORD=changeme_secure_password

# ============================================
# Backend Server IP Addresses
# ============================================
# IP address of Server A (Primary)
# This is where the primary Keycloak and PostgreSQL instances run
PRIMARY_BACKEND_IP=<server-a-ip>

# IP address of Server B (Replica)
# This is where the replica Keycloak and PostgreSQL instances run
REPLICA_BACKEND_IP=<server-b-ip>

# ============================================
# Backend Server Ports
# ============================================
# Primary Keycloak HTTP Port
PRIMARY_KEYCLOAK_PORT=8080

# Primary Keycloak Management Port (for health checks)
PRIMARY_KEYCLOAK_MGMT_PORT=9000

# Primary PostgreSQL Port
PRIMARY_POSTGRES_PORT=5432

# Replica Keycloak HTTP Port
REPLICA_KEYCLOAK_PORT=8081

# Replica Keycloak Management Port (for health checks)
REPLICA_KEYCLOAK_MGMT_PORT=9001

# Replica PostgreSQL Port
REPLICA_POSTGRES_PORT=5433

# ============================================
# Notes
# ============================================
# 1. For local testing with Docker networks, use the container IPs:
#    PRIMARY_SERVER_IP=172.41.1.10
#    REPLICA_SERVER_IP=172.41.2.20
#
# 2. For multi-server deployment, use the actual server IPs
#
# 3. Make sure firewall rules allow HAProxy to connect to these IPs:
#    - Port 8080/8081 for Keycloak
#    - Port 5432/5433 for PostgreSQL
#
# 4. Never commit the actual .env file to version control!
